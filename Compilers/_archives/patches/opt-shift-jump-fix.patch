 	{
 	  insn_info * jj = &(*infos)[jndex];
-	  if (jj->is_label())
+	  /* Stay inside the block: past a jump, what is changed or deleted here
+	     is still needed on the other path.  */
+	  if (jj->is_label() || jj->is_jump())
 	    break;
 
 	  // skip unrelated insns
@@ -5909,7 +5911,7 @@
 	      for (int kndex = jndex - 1; kndex > 0; --kndex)
