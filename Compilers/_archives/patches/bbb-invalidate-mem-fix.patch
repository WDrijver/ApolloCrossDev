+  /* True if a store to STORE cannot change the cached memory CACHED.  */
+  static bool
+  store_misses (rtx store, rtx cached)
+  {
+    if (MEM_READONLY_P(cached))
+      return true;
+
+    rtx saddr = XEXP(store, 0);
+    rtx cbase, sbase;
+    HOST_WIDE_INT coffset, soffset;
+    bool csplit = split_mem_address (XEXP(cached, 0), &cbase, &coffset);
+
+    /* A push or pop only touches memory at sp.  */
+    if (GET_RTX_CLASS (GET_CODE (saddr)) == RTX_AUTOINC)
+      return REGNO(XEXP(saddr, 0)) == STACK_POINTER_REGNUM
+	&& csplit && REGNO(cbase) != STACK_POINTER_REGNUM;
+
+    if (csplit && split_mem_address (saddr, &sbase, &soffset) && REGNO(sbase) == REGNO(cbase))
+      return false;
+
+    if (!alias_sets_conflict_p (MEM_ALIAS_SET(store), MEM_ALIAS_SET(cached)))
+      return true;
+    return nonoverlapping_memrefs_p (store, cached, false);
+  }
+
+  /* Forget every register holding a memory value the store to MEM may change.  */
+  void
+  invalidate_mem (rtx mem, unsigned index)
+  {
+    if (!MEM_P(mem))
+      return;
+    for (unsigned i = 0; i < FIRST_PSEUDO_REGISTER; ++i)
+      if (value[i] && MEM_P(value[i]) && !store_misses (mem, value[i]))
+	clear (SImode, i, index);
   }
 
